# SQLNest — template pour infra/.env.prod
# Ce fichier est commité. La vraie copie s'appelle .env.prod, contient
# les secrets, et est gitignored. Générer les secrets :
#
#   openssl rand -hex 32       # AUTH_SECRET
#   openssl rand -base64 24    # POSTGRES_PASSWORD (ensuite pipe | tr -d '/+=')

NODE_ENV=production
PORT=4000

# ─── URLs publiques ──────────────────────────────────────────────────────
BASE_URL=https://dev.sqlnest.io
FRONTEND_URL=https://dev.sqlnest.io
TRUSTED_ORIGINS=https://dev.sqlnest.io
COOKIE_DOMAIN=dev.sqlnest.io
PUBLIC_API_URL=https://dev.sqlnest.io

# ─── Better Auth / crypto ────────────────────────────────────────────────
# Min 32 chars. Regex backend rejette "changeme|replace|placeholder".
# ATTENTION : sert aussi de seed pour la keypair Ed25519 d'identité du
# backend (voir apps/backend/src/plugins/06-backend-identity.plugin.ts).
# Rotation = invalide sessions ET change l'identité backend.
AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32

# ─── Postgres ────────────────────────────────────────────────────────────
POSTGRES_USER=sqlnest
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_24
POSTGRES_DB=sqlnest
DATABASE_URL=postgres://sqlnest:CHANGE_ME@postgres:5432/sqlnest

# ─── OAuth (optionnel — laisser vide pour désactiver) ────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
