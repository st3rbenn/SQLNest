# SQLNest — Caddyfile derrière un TLS terminator upstream
# L'architecte réseau termine TLS chez son openresty et forward en HTTP
# clair vers cette VM sur le port 80. Aucun cert à gérer côté Caddy —
# on ne fait que du reverse proxy interne : /api/* → backend, /* → frontend.

{
    # Auto-HTTPS off : l'upstream gère TLS, on ne veut ni ACME ni redirect
    # 80→443 côté Caddy.
    auto_https off
}

:80 {
    encode zstd gzip

    handle /api/* {
        reverse_proxy backend:4000
    }

    handle {
        reverse_proxy frontend:80
    }
}
