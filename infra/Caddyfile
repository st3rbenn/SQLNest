# SQLNest — prod Caddyfile
# Origine unique dev.sqlnest.io. Caddy fait :
#   1. TLS Let's Encrypt (HTTP-01 sur port 80, Cloudflare DNS-only)
#   2. Compression zstd + gzip
#   3. Reverse proxy /api/* → backend (WS upgrade auto)
#   4. Reverse proxy /* → frontend static

{
    email admin@sqlnest.io

    # ⚠ TEMPORAIRE — LE staging (rate limits énormes, cert non-trusted).
    # À retirer une fois le challenge validé + storage staging purgé, sinon
    # le browser affichera un warning cert.
    acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

dev.sqlnest.io {
    encode zstd gzip

    handle /api/* {
        reverse_proxy backend:4000
    }

    handle {
        reverse_proxy frontend:80
    }
}
