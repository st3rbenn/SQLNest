{
	"name": "sqlnest",
	"version": "0.0.7",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"check": "biome check --write .",
		"db:up": "docker compose -f infra/docker-compose.yml up -d",
		"db:down": "docker compose -f infra/docker-compose.yml down",
		"db:reset": "docker compose -f infra/docker-compose.yml down -v && docker compose -f infra/docker-compose.yml up -d",
		"db:logs": "docker compose -f infra/docker-compose.yml logs -f",
		"db:seed:shop": "node infra/scripts/seed-shop.mjs",
		"db:seed:chinook": "bash infra/scripts/seed-chinook.sh",
		"db:seed:chinook:mongo": "node infra/scripts/seed-chinook-mongo.mjs",
		"db:seed:chinook:mssql": "bash infra/scripts/seed-chinook-mssql.sh",
		"test:chinook-parity": "SNQL_TEST_PG_CHINOOK_URL=postgres://sqlnest:sqlnest@localhost:5433/chinook SNQL_TEST_MONGO_CHINOOK_URL=mongodb://localhost:27017/chinook?directConnection=true pnpm --filter @sqlnest/engine test --run chinook-parity",
		"app:db:generate": "pnpm --filter @sqlnest/db db:generate",
		"app:db:migrate": "pnpm --filter @sqlnest/db db:migrate",
		"app:db:studio": "pnpm --filter @sqlnest/db db:studio",
		"app:db:test:migrate": "DATABASE_URL=postgres://sqlnest_test:sqlnest_test_dev@localhost:5435/sqlnest_test pnpm --filter @sqlnest/db db:migrate"
	},
	"author": "Anthonin COLAS <anthonincolaspro@gmail.com>",
	"packageManager": "pnpm@10.17.1",
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"mongodb": "^6.10.0",
		"pg": "^8.13.1",
		"typescript": "catalog:"
	},
	"pnpm": {
		"overrides": {
			"vite": "npm:rolldown-vite@7.1.12"
		}
	}
}
