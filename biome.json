{
	"$schema": "https://biomejs.dev/schemas/2.2.5/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"includes": ["apps/**/*", "packages/**/*", "!**/*.gen.ts", "!**/generated/**"],
		"experimentalScannerIgnores": ["**/node_modules/**", "**/dist/**"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"performance": {
				"noBarrelFile": "off",
				"useTopLevelRegex": "error"
			},
			"a11y": "info"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "none"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.test.ts"],
			"linter": { "rules": { "performance": { "useTopLevelRegex": "off" } } }
		}
	]
}
