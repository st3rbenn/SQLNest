{
	"$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
	"plugins": ["@biomejs/plugin-typescript"],
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"includes": ["apps/**/*", "packages/**/*"],
		"experimentalScannerIgnores": ["**/node_modules/**", "**/dist/**"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"performance": "error",
			"a11y": "info"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "none"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
