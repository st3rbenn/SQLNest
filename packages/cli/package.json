{
	"name": "@sqlnest/cli",
	"version": "0.0.2",
	"type": "module",
	"description": "CLI local SQLNest — device flow + tunnel WSS vers ta DB Postgres (Mongo v1.1).",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"bin": {
		"sqlnest": "./dist/sqlnest.mjs"
	},
	"files": [
		"src",
		"dist",
		"package.json",
		"README.md"
	],
	"scripts": {
		"build": "esbuild src/bin.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/sqlnest.mjs --banner:js='#!/usr/bin/env node' --define:process.env.NODE_ENV=\\\"production\\\" --minify-syntax --external:@noble/curves --external:@noble/hashes --external:@noble/ciphers --external:msgpackr --external:smol-toml --external:ws --external:mongodb --external:pg --external:@inquirer/* --external:mute-stream --external:cli-width --external:@sindresorhus/is --external:signal-exit --external:yoctocolors-cjs",
		"postbuild": "chmod +x dist/sqlnest.mjs",
		"prepublishOnly": "pnpm build",
		"test": "vitest run",
		"test:watch": "vitest",
		"type-check": "tsc --project tsconfig.json",
		"check": "biome check --write"
	},
	"dependencies": {
		"@inquirer/prompts": "^8.5.2",
		"@noble/ciphers": "^2.0.5",
		"@noble/curves": "^2.3.0",
		"@noble/hashes": "^2.3.0",
		"mongodb": "^6.10.0",
		"msgpackr": "^1.11.2",
		"pg": "^8.13.1",
		"smol-toml": "^1.7.1",
		"ws": "^8.21.2"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@sqlnest/engine": "workspace:*",
		"@sqlnest/snql": "workspace:*",
		"@sqlnest/tunnel-protocol": "workspace:*",
		"@types/node": "^24.6.0",
		"@types/ws": "^8.5.13",
		"esbuild": "^0.28.1",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22"
	},
	"keywords": [
		"sqlnest",
		"cli",
		"tunnel",
		"postgres"
	],
	"author": "Anthonin COLAS <anthonincolaspro@gmail.com>",
	"license": "ISC",
	"packageManager": "pnpm@10.17.1"
}
