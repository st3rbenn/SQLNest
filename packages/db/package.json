{
	"name": "@sqlnest/db",
	"version": "0.0.1",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./schema": {
			"types": "./src/schema.ts",
			"default": "./src/schema.ts"
		}
	},
	"files": [
		"src",
		"drizzle",
		"drizzle.config.ts",
		"package.json"
	],
	"scripts": {
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"type-check": "tsc --project tsconfig.json",
		"check": "biome check --write"
	},
	"dependencies": {
		"drizzle-orm": "^0.36.4",
		"postgres": "^3.4.5"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/node": "^24.6.0",
		"dotenv": "^16.4.5",
		"drizzle-kit": "^0.28.1",
		"typescript": "catalog:"
	},
	"keywords": [],
	"author": "Anthonin COLAS <anthonincolaspro@gmail.com>",
	"license": "ISC",
	"packageManager": "pnpm@10.17.1"
}
