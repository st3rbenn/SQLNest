{
	"name": "@sqlnest/snql",
	"version": "0.0.1",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"package.json"
	],
	"scripts": {
		"build": "vite build && tsc --project tsconfig.lib.json",
		"dev": "tsx src/playground.ts | pino-pretty",
		"type-check": "tsc --project tsconfig.lib.json --noEmit",
		"check": "biome check --write"
	},
	"dependencies": {
		"pino": "^10.0.0",
		"mysql-tokenizer": "^1.0.7",
		"ts-mysql-parser": "^0.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"@types/node": "^24.6.0",
		"vite": "^7.1.7",
		"pino-pretty": "^13.1.1"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.17.1"
}
