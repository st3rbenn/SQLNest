{
	"name": "@sqlnest/snql",
	"version": "0.0.1",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/snql.js"
		}
	},
	"files": [
		"dist",
		"package.json"
	],
	"scripts": {
		"build": "vite build && tsc --project tsconfig.lib.json",
		"dev": "tsx src/playground.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"type-check": "tsc --project tsconfig.lib.json --noEmit",
		"check": "biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"@types/node": "^24.6.0",
		"vite": "^7.1.7",
		"tsx": "^4.20.6"
	},
	"keywords": [],
	"author": "Anthonin COLAS <anthonincolaspro@gmail.com>",
	"license": "ISC",
	"packageManager": "pnpm@10.17.1"
}
